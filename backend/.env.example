# =============================================
# dTS Instruments — Backend Environment
# =============================================
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-min-32-chars
PORT=3000

# =============================================
# Microsoft Exchange / Graph API Integration
# =============================================
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id-or-common
AZURE_CLIENT_SECRET=your-azure-client-secret
EXCHANGE_REDIRECT_URI=https://app.dtsinstruments.com/crm


# Stable email identity pilot (requires the reviewed crm_activities migration).
CRM_EMAIL_IDENTITY_ENABLED=false
CRM_EMAIL_IDENTITY_EMAILS=
