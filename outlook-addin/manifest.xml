<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
  xsi:type="MailApp">

  <!-- Identificador único del Add-in de dTS Instruments -->
  <Id>b41a9a83-6f45-4a67-9c98-1e4396fae852</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>dTS Instruments S.L.</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="dTS Instruments CRM" />
  <Description DefaultValue="Complemento oficial de dTS Instruments para registrar, categorizar y vincular correos electrónicos a contactos y ofertas comerciales directamente en dTS CRM." />

  <!-- Iconos corporativos del complemento -->
  <IconUrl DefaultValue="https://app.dtsinstruments.com/outlook-addin/icon.png" />
  <HighResolutionIconUrl DefaultValue="https://app.dtsinstruments.com/outlook-addin/icon.png" />
  <SupportUrl DefaultValue="https://dtsinstruments.com" />

  <!-- Dominios autorizados para cargar en el Taskpane -->
  <AppDomains>
    <AppDomain>https://app.dtsinstruments.com</AppDomain>
    <AppDomain>https://dtsinstruments.com</AppDomain>
  </AppDomains>

  <!-- Compatibilidad con Outlook -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <!-- Formulario Legacy / Fallback -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://app.dtsinstruments.com/outlook-crm" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permiso para leer metadatos y cuerpo del correo seleccionado -->
  <Permissions>ReadItem</Permissions>

  <!-- Regla de activación: Se activa al leer cualquier mensaje de correo -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides v1.0 para Ribbon y barra de herramientas moderna de Outlook -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Description resid="verDescription" />
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Extensión para la pantalla de lectura de mensajes -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="dtsCrmReadGroup">
                <Label resid="GroupLabel" />
                <!-- Botón principal en la cinta de opciones -->
                <Control xsi:type="Button" id="btnRegisterInDtsCrm">
                  <Label resid="BtnLabel" />
                  <Supertip>
                    <Title resid="BtnTitle" />
                    <Description resid="BtnTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Recursos de texto e iconos -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://app.dtsinstruments.com/outlook-addin/icon.png" />
        <bt:Image id="Icon32" DefaultValue="https://app.dtsinstruments.com/outlook-addin/icon.png" />
        <bt:Image id="Icon80" DefaultValue="https://app.dtsinstruments.com/outlook-addin/icon.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://app.dtsinstruments.com/outlook-crm" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="dTS CRM" />
        <bt:String id="BtnLabel" DefaultValue="Registrar en dTS CRM" />
        <bt:String id="BtnTitle" DefaultValue="dTS Instruments CRM" />
        <bt:String id="verDescription" DefaultValue="Complemento oficial de dTS Instruments para registrar correos en dTS CRM." />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="BtnTooltip" DefaultValue="Abre el panel de dTS CRM para identificar al cliente, asociar a una oferta y guardar este correo en el historial comercial con 1 clic." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
